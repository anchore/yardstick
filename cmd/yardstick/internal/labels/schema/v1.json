{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anchore/yardstick/cmd/yardstick/internal/labels/schema/v1.json",
  "title": "yardstick label file, format v1",
  "description": "One subject's labels for one package type (or, in image.json, labels that name no package; in global/, labels that hold on every subject). Unknown fields are allowed, so an additive change never breaks an older reader.",
  "type": "object",
  "required": ["schema", "labels"],
  "properties": {
    "schema": {"const": "v1"},
    "subject": {"$ref": "#/$defs/subject"},
    "labels": {"type": "array", "items": {"$ref": "#/$defs/label"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "properties": {
        "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
        "sbom": {"$ref": "#/$defs/digest"},
        "platform": {"type": "string", "pattern": "^[a-z0-9]+/[a-z0-9_]+(/[a-z0-9]+)?$"}
      },
      "oneOf": [{"required": ["image"]}, {"required": ["sbom"]}]
    },
    "label": {
      "type": "object",
      "required": ["vulnerability", "verdict", "author", "firstIssued", "lastUpdated"],
      "properties": {
        "package": {"type": "string", "pattern": "^pkg:[a-z0-9.+-]+/"},
        "vulnerability": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["tp", "fp", "unclear"]},
        "justification": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "author", "at"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "author": {"type": "string", "minLength": 1},
              "at": {"type": "string", "format": "date-time"}
            }
          }
        },
        "seenIn": {
          "type": "object",
          "properties": {
            "sbom": {"$ref": "#/$defs/digest"},
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "version"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "firstIssued": {"type": "string", "format": "date-time"},
        "lastUpdated": {"type": "string", "format": "date-time"}
      },
      "if": {"properties": {"verdict": {"enum": ["fp", "unclear"]}}},
      "then": {"required": ["justification"]}
    },
    "evidence": {
      "type": "object",
      "required": ["facts"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "fact": {
      "type": "object",
      "required": ["source", "about", "field", "value", "observedAt"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "about": {"type": "object", "additionalProperties": {"type": "string"}},
        "field": {"type": "string", "minLength": 1},
        "value": {"type": "string"},
        "observedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
